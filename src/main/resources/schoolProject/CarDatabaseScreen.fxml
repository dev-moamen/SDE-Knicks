<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.Controllers.CarDatabaseScreenController">
   <top>
      <HBox styleClass="header">
         <children>
            <Button fx:id="carDatabaseBack" mnemonicParsing="false"
                    onAction="#switchToAdminScreen" styleClass="btn, btn-back" text="Back"/>
            <Label alignment="CENTER" maxWidth="Infinity" styleClass="title"
                   text="Car Database" HBox.hgrow="ALWAYS"/>
            <Region styleClass="header-spacer"/>
         </children>
      </HBox>
   </top>
   <center>
      <VBox styleClass="content">
         <VBox styleClass="card">
            <children>
               <Label styleClass="eyebrow" text="VEHICLE REGISTRY"/>
               <Label styleClass="section-title" text="Registered vehicles."/>
               <TableView fx:id="carsTable" prefHeight="520.0" prefWidth="730.0">
                  <columns>
                     <TableColumn fx:id="licensePlateEntry" prefWidth="185.33333778381348" text="License Plate"/>
                     <TableColumn fx:id="brandEntry" prefWidth="150.6666717529297" text="Brand"/>
                     <TableColumn fx:id="modelEntry" prefWidth="181.99990844726562" text="Model"/>
                     <TableColumn fx:id="colorEntry" prefWidth="160.0" text="Color"/>
                  </columns>
               </TableView>
            </children>
         </VBox>
      </VBox>
   </center>
</BorderPane>
