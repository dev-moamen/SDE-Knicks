<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="530.0" prefWidth="670.0" spacing="15.0"
      style="-fx-background-color: linear-gradient(to bottom right, #101827, #243447);"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="schoolProject.MyReservationsScreenController">

    <padding>
        <Insets top="15.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <children>
        <AnchorPane prefHeight="100.0" minHeight="100.0" prefWidth="630.0">
            <children>
                <Button fx:id="myReservationsBack"
                        layoutX="0.0" layoutY="10.0"
                        mnemonicParsing="false"
                        onAction="#switchToHomeScreen"
                        prefHeight="43.0" prefWidth="80.0"
                        text="Back"
                        style="-fx-background-color: #34465e; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-size: 14px;"/>

                <Label layoutX="95.0" layoutY="0.0"
                       prefHeight="90.0" prefWidth="430.0"
                       alignment="CENTER"
                       text="MY RESERVATIONS"
                       textFill="#f1f5f9">
                    <font>
                        <Font name="Lucida Fax Regular" size="32.0"/>
                    </font>
                </Label>

                <Label layoutX="530.0" layoutY="15.0"
                       prefHeight="50.0" prefWidth="100.0"
                       text="PARKIFY"
                       textFill="#94a3b8">
                    <font>
                        <Font name="Javanese Text" size="22.0"/>
                    </font>
                </Label>
            </children>
        </AnchorPane>

        <TableView fx:id="reservationsTable"
                   prefHeight="315.0" prefWidth="630.0"
                   style="-fx-background-color: #1e293b; -fx-background-radius: 12; -fx-border-color: #475569; -fx-border-radius: 12; -fx-border-width: 1.5;">
            <columns>
                <TableColumn prefWidth="125.0" text="Arrival Time"/>
                <TableColumn prefWidth="130.0" text="Departure Time"/>
                <TableColumn prefWidth="105.0" text="Parking Spot"/>
                <TableColumn prefWidth="145.0" text="License Plate"/>
                <TableColumn prefWidth="100.0" text="Cost"/>
            </columns>
        </TableView>
    </children>
</VBox>