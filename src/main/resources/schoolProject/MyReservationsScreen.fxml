<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.MyReservationsScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="myReservationsBack"
                        mnemonicParsing="false"
                        onAction="#switchToHomeScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="My Reservations"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content">
            <children>
                <TableView fx:id="reservationsTable" prefHeight="560.0" prefWidth="720.0" maxWidth="720.0">
                    <columns>
                        <TableColumn prefWidth="145.0" text="Arrival Time"/>
                        <TableColumn prefWidth="155.0" text="Departure Time"/>
                        <TableColumn prefWidth="125.0" text="Parking Spot"/>
                        <TableColumn prefWidth="165.0" text="License Plate"/>
                        <TableColumn prefWidth="120.0" text="Cost"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
