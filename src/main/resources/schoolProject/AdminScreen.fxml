<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.Controllers.AdminScreenController">
   <top>
      <HBox styleClass="header">
         <children>
            <Button fx:id="adminScreenBack" mnemonicParsing="false"
                    onAction="#switchToIntroductionScreen" styleClass="btn, btn-back" text="Back"/>
            <Label alignment="CENTER" maxWidth="Infinity" styleClass="title"
                   text="Admin Dashboard" HBox.hgrow="ALWAYS"/>
            <Region styleClass="header-spacer"/>
         </children>
      </HBox>
   </top>
   <center>
      <VBox styleClass="content">
         <VBox styleClass="card">
            <children>
               <Label styleClass="eyebrow" text="ADMIN DASHBOARD"/>
               <Label styleClass="section-title" text="Manage the parking system."/>
               <Button fx:id="scanPlate" mnemonicParsing="false"
                       onAction="#switchToScanPlateScreen" styleClass="btn, btn-nav" text="Scan Plate"/>
               <Button fx:id="carDatabase" mnemonicParsing="false"
                       onAction="#switchToCarDatabaseScreen" styleClass="btn, btn-nav" text="Car Database"/>
               <Button fx:id="paymentDatabase" mnemonicParsing="false"
                       onAction="#switchToPaymentDatabaseScreen" styleClass="btn, btn-nav" text="Payment Database"/>
            </children>
         </VBox>
      </VBox>
   </center>
</BorderPane>
