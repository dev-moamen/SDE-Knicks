<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="530.0" prefWidth="670.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolProject.SecondaryController">
    <children>
      <AnchorPane prefHeight="200.0" prefWidth="200.0">
         <children>
              <Label layoutX="159.0" layoutY="-30.0" prefHeight="194.0" prefWidth="311.0" text="PARKIFY">
               <font>
                  <Font name="Javanese Text" size="70.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="77.0" prefWidth="630.0">
         <children>
            <Button fx:id="myReservations" layoutX="187.0" layoutY="-19.0" mnemonicParsing="false" onAction="#switchToMyReservationsScreen" text="My Reservations">
               <font>
                  <Font size="30.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="64.0" prefWidth="630.0">
         <children>
              <Button fx:id="parkingLot" layoutX="220.0" layoutY="-19.0" onAction="#switchToParkingLotScreen" text="Parking Lot" textAlignment="CENTER">
               <font>
                  <Font size="30.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
      <AnchorPane prefHeight="57.0" prefWidth="630.0">
         <children>
            <Button fx:id="settings" layoutX="242.0" layoutY="-9.0" mnemonicParsing="false" onAction="#switchToSettingsScreen" text="Settings" textAlignment="CENTER">
               <font>
                  <Font size="30.0" />
               </font>
            </Button>
         </children>
      </AnchorPane>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
