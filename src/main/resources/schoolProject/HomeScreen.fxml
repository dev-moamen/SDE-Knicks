<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.HomeScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="homeScreenBack"
                        mnemonicParsing="false"
                        onAction="#switchToIntroductionScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="Parkify"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content">
            <children>
                <VBox styleClass="card">
                    <children>
                        <Label styleClass="subtitle" text="What would you like to do?"/>
                        <Button fx:id="myProfile"
                                mnemonicParsing="false"
                                onAction="#switchToMyProfileScreen"
                                styleClass="btn, btn-nav"
                                text="My Profile"/>
                        <Button fx:id="parkingLot"
                                mnemonicParsing="false"
                                onAction="#switchToParkingLotScreen"
                                styleClass="btn, btn-nav"
                                text="Parking Lot"/>
                        <Button fx:id="myReservations"
                                mnemonicParsing="false"
                                onAction="#switchToMyReservationsScreen"
                                styleClass="btn, btn-nav"
                                text="My Reservations"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
