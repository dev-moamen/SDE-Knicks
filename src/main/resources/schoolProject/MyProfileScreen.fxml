<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.MyProfileScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="myProfileScreenBack"
                        mnemonicParsing="false"
                        onAction="#switchToHomeScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="My Profile"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content">
            <children>
                <VBox styleClass="card">
                    <children>
                        <Label styleClass="subtitle" text="Manage your account details"/>
                        <Button fx:id="myCars"
                                mnemonicParsing="false"
                                onAction="#switchToMyCarsScreen"
                                styleClass="btn, btn-nav"
                                text="My Cars"/>
                        <Button fx:id="paymentInformation"
                                mnemonicParsing="false"
                                onAction="#switchToPaymentInformationScreen"
                                styleClass="btn, btn-nav"
                                text="Payment Information"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
