<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="800.0"
           style="-fx-background-color: linear-gradient(to bottom right, #101827, #243447);"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="schoolProject.MyProfileScreenController">
    <children>
        <VBox alignment="CENTER" spacing="24.0" prefHeight="800.0" prefWidth="800.0" pickOnBounds="false">
            <children>
                <Label alignment="CENTER" text="MY PROFILE" textFill="#f1f5f9">
                    <font>
                        <Font name="Javanese Text" size="55.0"/>
                    </font>
                </Label>
                <Button fx:id="myCars"
                        mnemonicParsing="false"
                        onAction="#switchToMyCarsScreen"
                        prefHeight="65.0"
                        prefWidth="321.0"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #60a5fa; -fx-border-width: 1.5; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0.2, 0, 4);"
                        text="My Cars"
                        textAlignment="CENTER">
                    <font>
                        <Font size="28.0"/>
                    </font>
                </Button>
                <Button fx:id="paymentInformation"
                        mnemonicParsing="false"
                        onAction="#switchToPaymentInformationScreen"
                        prefHeight="65.0"
                        prefWidth="381.0"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #60a5fa; -fx-border-width: 1.5; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 10, 0.2, 0, 4);"
                        text="Payment Information"
                        textAlignment="CENTER">
                    <font>
                        <Font size="27.0"/>
                    </font>
                </Button>
            </children>
        </VBox>

        <Button fx:id="myProfileScreenBack"
                mnemonicParsing="false"
                onAction="#switchToHomeScreen"
                prefHeight="43.0"
                prefWidth="80.0"
                style="-fx-background-color: #34465e; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-size: 14px;"
                text="Back"
                StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets top="20.0" left="20.0"/>
            </StackPane.margin>
        </Button>
    </children>
</StackPane>
