<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.PaymentInformationScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="paymentInformationBack"
                        mnemonicParsing="false"
                        onAction="#switchToMyProfileScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="Payment Information"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content">
            <children>
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <VBox styleClass="form-card" prefWidth="240.0">
                            <children>
                                <Label styleClass="field-label" text="CARD NUMBER"/>
                                <TextField fx:id="cardNumberLoader" styleClass="field"/>
                                <Label styleClass="field-label" text="EXPIRATION"/>
                                <TextField fx:id="expirationLoader" promptText="MM/YY" styleClass="field"/>
                                <Label styleClass="field-label" text="CVV"/>
                                <TextField fx:id="cvvLoader" styleClass="field"/>
                                <Label styleClass="field-label" text="NAME"/>
                                <TextField fx:id="nameLoader" styleClass="field"/>
                                <Button fx:id="paymentInformationInputButton"
                                        mnemonicParsing="false"
                                        onAction="#loadPaymentInformationInputs"
                                        styleClass="btn, btn-small"
                                        text="Add card"/>
                            </children>
                        </VBox>
                        <TableView fx:id="paymentTable" prefHeight="460.0" prefWidth="450.0">
                            <columns>
                                <TableColumn fx:id="cardNumberEntry" prefWidth="160.0" text="Card Number"/>
                                <TableColumn fx:id="expirationEntry" prefWidth="90.0" text="Expiration"/>
                                <TableColumn fx:id="cvvEntry" prefWidth="60.0" text="CVV"/>
                                <TableColumn fx:id="nameEntry" prefWidth="138.0" text="Name"/>
                            </columns>
                        </TableView>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
