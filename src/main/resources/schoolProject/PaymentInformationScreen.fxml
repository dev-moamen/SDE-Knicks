<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="800.0"
           style="-fx-background-color: linear-gradient(to bottom right, #101827, #243447);"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="schoolProject.PaymentInformationScreenController">
    <children>
        <VBox alignment="CENTER" spacing="28.0" prefHeight="800.0" prefWidth="800.0" pickOnBounds="false">
            <padding>
                <Insets top="80.0" right="24.0" bottom="30.0" left="24.0"/>
            </padding>
            <children>
                <Label alignment="CENTER" text="Payment Information" textFill="#f8fafc">
                    <font>
                        <Font name="Lucida Fax Regular" size="38.0"/>
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="24.0">
                    <children>
                        <VBox alignment="CENTER" spacing="12.0" prefWidth="240.0">
                            <children>
                                <Label text="Card Number:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="cardNumberLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="200.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Label text="Expiration:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="expirationLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="200.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Label text="CVV:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="cvvLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="200.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Label text="Name:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="nameLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="200.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Button fx:id="paymentInformationInputButton"
                                        mnemonicParsing="false"
                                        onAction="#loadPaymentInformationInputs"
                                        prefHeight="40.0"
                                        prefWidth="120.0"
                                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-color: #60a5fa; -fx-border-radius: 8; -fx-cursor: hand;"
                                        text="Input">
                                    <font>
                                        <Font name="System Bold" size="16.0"/>
                                    </font>
                                    <VBox.margin>
                                        <Insets top="8.0"/>
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>

                        <TableView fx:id="paymentTable"
                                   prefHeight="420.0"
                                   prefWidth="460.0"
                                   style="-fx-background-color: #172437; -fx-border-color: #334155;">
                            <columns>
                                <TableColumn fx:id="cardNumberEntry" prefWidth="160.0" text="Card Number"/>
                                <TableColumn fx:id="expirationEntry" prefWidth="90.0" text="Expiration"/>
                                <TableColumn fx:id="cvvEntry" prefWidth="60.0" text="CVV"/>
                                <TableColumn fx:id="nameEntry" prefWidth="148.0" text="Name"/>
                            </columns>
                        </TableView>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Button fx:id="paymentInformationBack"
                mnemonicParsing="false"
                onAction="#switchToMyProfileScreen"
                prefHeight="43.0"
                prefWidth="80.0"
                style="-fx-background-color: #34465e; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-size: 14px;"
                text="Back"
                StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets top="20.0" left="20.0"/>
            </StackPane.margin>
        </Button>
    </children>
</StackPane>
