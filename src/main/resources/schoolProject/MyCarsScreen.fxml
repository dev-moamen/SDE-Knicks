<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.MyCarsScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="myCarsBack"
                        mnemonicParsing="false"
                        onAction="#switchToMyProfileScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="My Cars"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content">
            <children>
                <HBox alignment="CENTER" spacing="24.0">
                    <children>
                        <VBox styleClass="form-card" prefWidth="250.0">
                            <children>
                                <Label styleClass="field-label" text="LICENSE PLATE"/>
                                <TextField fx:id="licensePlateLoader" styleClass="field"/>
                                <Label styleClass="field-label" text="BRAND"/>
                                <TextField fx:id="brandLoader" styleClass="field"/>
                                <Label styleClass="field-label" text="MODEL"/>
                                <TextField fx:id="modelLoader" styleClass="field"/>
                                <Label styleClass="field-label" text="COLOR"/>
                                <TextField fx:id="colorLoader" styleClass="field"/>
                                <Button fx:id="carInputButton"
                                        mnemonicParsing="false"
                                        onAction="#loadCarInputs"
                                        styleClass="btn, btn-small"
                                        text="Add car"/>
                            </children>
                        </VBox>
                        <TableView fx:id="carsTable" prefHeight="460.0" prefWidth="430.0">
                            <columns>
                                <TableColumn fx:id="licensePlateEntry" prefWidth="120.0" text="License Plate"/>
                                <TableColumn fx:id="brandEntry" prefWidth="90.0" text="Brand"/>
                                <TableColumn fx:id="modelEntry" prefWidth="110.0" text="Model"/>
                                <TableColumn fx:id="colorEntry" prefWidth="98.0" text="Color"/>
                            </columns>
                        </TableView>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
