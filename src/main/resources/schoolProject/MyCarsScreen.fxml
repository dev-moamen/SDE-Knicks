<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.TableColumn?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.layout.AnchorPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.text.Font?>
        <?import javafx.scene.text.Text?>

<VBox prefHeight="530.0" prefWidth="670.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="schoolProject.MyCarsScreenController"
      style="-fx-background-color: linear-gradient(to bottom right, #101827, #243447);">

    <children>
        <AnchorPane prefHeight="200.0" prefWidth="670.0">
            <children>
                <Label layoutX="509.0" layoutY="-12.0"
                       prefHeight="104.0" prefWidth="153.0"
                       text="PARKIFY" textFill="#60a5fa">
                    <font>
                        <Font name="Javanese Text" size="34.0"/>
                    </font>
                </Label>

                <Label layoutX="236.0" layoutY="36.0"
                       prefHeight="70.0" prefWidth="199.0"
                       text="My Cars" textFill="#f8fafc">
                    <font>
                        <Font name="Lucida Fax Regular" size="48.0"/>
                    </font>
                </Label>

                <Button fx:id="myCarsBack"
                        layoutX="14.0" layoutY="14.0"
                        prefHeight="43.0" prefWidth="69.0"
                        text="Back"
                        onAction="#switchToMyProfileScreen"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-background-radius: 8;
                               -fx-border-color: #60a5fa;
                               -fx-border-radius: 8;"/>

                <Text layoutX="14.0" layoutY="172.0"
                      text="License Plate:" fill="#f8fafc">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Text>

                <TextField fx:id="licensePlateLoader"
                           layoutX="117.0" layoutY="154.0"
                           prefHeight="25.0" prefWidth="170.0"
                           style="-fx-background-color: #1e293b;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #94a3b8;
                                  -fx-border-color: #475569;
                                  -fx-border-radius: 5;
                                  -fx-background-radius: 5;"/>
            </children>
        </AnchorPane>

        <AnchorPane prefHeight="330.0" prefWidth="670.0">
            <children>
                <TableView fx:id="carsTable"
                           layoutX="300.0" layoutY="-78.0"
                           prefHeight="381.0" prefWidth="349.0"
                           style="-fx-background-color: #172437;
                                  -fx-border-color: #334155;">
                    <columns>
                        <TableColumn fx:id="licensePlateEntry"
                                     prefWidth="104.0"
                                     text="License Plate"/>
                        <TableColumn fx:id="brandEntry"
                                     prefWidth="75.0"
                                     text="Brand"/>
                        <TableColumn fx:id="modelEntry"
                                     text="Model"/>
                        <TableColumn fx:id="colorEntry"
                                     prefWidth="88.0"
                                     text="Color"/>
                    </columns>
                </TableView>

                <TextField fx:id="brandLoader"
                           layoutX="117.0" layoutY="42.0"
                           prefHeight="25.0" prefWidth="170.0"
                           style="-fx-background-color: #1e293b;
                                  -fx-text-fill: white;
                                  -fx-border-color: #475569;
                                  -fx-border-radius: 5;
                                  -fx-background-radius: 5;"/>

                <Text layoutX="59.0" layoutY="60.0"
                      text="Brand:" fill="#f8fafc">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Text>

                <TextField fx:id="modelLoader"
                           layoutX="117.0" layoutY="133.0"
                           prefHeight="25.0" prefWidth="170.0"
                           style="-fx-background-color: #1e293b;
                                  -fx-text-fill: white;
                                  -fx-border-color: #475569;
                                  -fx-border-radius: 5;
                                  -fx-background-radius: 5;"/>

                <TextField fx:id="colorLoader"
                           layoutX="117.0" layoutY="230.0"
                           prefHeight="25.0" prefWidth="170.0"
                           style="-fx-background-color: #1e293b;
                                  -fx-text-fill: white;
                                  -fx-border-color: #475569;
                                  -fx-border-radius: 5;
                                  -fx-background-radius: 5;"/>

                <Text layoutX="56.0" layoutY="151.0"
                      text="Model:" fill="#f8fafc">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Text>

                <Text layoutX="59.0" layoutY="248.0"
                      text="Color:" fill="#f8fafc">
                    <font>
                        <Font name="System Bold" size="14.0"/>
                    </font>
                </Text>

                <Button fx:id="carInputButton"
                        layoutX="117.0" layoutY="281.0"
                        prefHeight="35.0" prefWidth="88.0"
                        text="Input"
                        onAction="#loadCarInputs"
                        style="-fx-background-color: #2563eb;
                               -fx-text-fill: white;
                               -fx-background-radius: 8;
                               -fx-border-color: #60a5fa;
                               -fx-border-radius: 8;
                               -fx-cursor: hand;">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Button>
            </children>
        </AnchorPane>
    </children>
</VBox>