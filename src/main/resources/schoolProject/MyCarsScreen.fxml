<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="800.0" prefWidth="800.0"
           style="-fx-background-color: linear-gradient(to bottom right, #101827, #243447);"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="schoolProject.MyCarsScreenController">
    <children>
        <VBox alignment="CENTER" spacing="28.0" prefHeight="800.0" prefWidth="800.0" pickOnBounds="false">
            <padding>
                <Insets top="80.0" right="30.0" bottom="30.0" left="30.0"/>
            </padding>
            <children>
                <Label alignment="CENTER" text="My Cars" textFill="#f8fafc">
                    <font>
                        <Font name="Lucida Fax Regular" size="48.0"/>
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="28.0">
                    <children>
                        <VBox alignment="CENTER" spacing="12.0" prefWidth="260.0">
                            <children>
                                <Label text="License Plate:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="licensePlateLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="220.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-prompt-text-fill: #94a3b8; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Label text="Brand:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="brandLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="220.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Label text="Model:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="modelLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="220.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Label text="Color:" textFill="#f8fafc">
                                    <font>
                                        <Font name="System Bold" size="14.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="colorLoader"
                                           alignment="CENTER"
                                           prefHeight="32.0"
                                           prefWidth="220.0"
                                           style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-background-radius: 5;"/>
                                <Button fx:id="carInputButton"
                                        mnemonicParsing="false"
                                        onAction="#loadCarInputs"
                                        prefHeight="40.0"
                                        prefWidth="120.0"
                                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 8; -fx-border-color: #60a5fa; -fx-border-radius: 8; -fx-cursor: hand;"
                                        text="Input">
                                    <font>
                                        <Font name="System Bold" size="16.0"/>
                                    </font>
                                    <VBox.margin>
                                        <Insets top="8.0"/>
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>

                        <TableView fx:id="carsTable"
                                   prefHeight="420.0"
                                   prefWidth="420.0"
                                   style="-fx-background-color: #172437; -fx-border-color: #334155;">
                            <columns>
                                <TableColumn fx:id="licensePlateEntry" prefWidth="120.0" text="License Plate"/>
                                <TableColumn fx:id="brandEntry" prefWidth="90.0" text="Brand"/>
                                <TableColumn fx:id="modelEntry" prefWidth="110.0" text="Model"/>
                                <TableColumn fx:id="colorEntry" prefWidth="98.0" text="Color"/>
                            </columns>
                        </TableView>
                    </children>
                </HBox>
            </children>
        </VBox>

        <Button fx:id="myCarsBack"
                mnemonicParsing="false"
                onAction="#switchToMyProfileScreen"
                prefHeight="43.0"
                prefWidth="80.0"
                style="-fx-background-color: #34465e; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-size: 14px;"
                text="Back"
                StackPane.alignment="TOP_LEFT">
            <StackPane.margin>
                <Insets top="20.0" left="20.0"/>
            </StackPane.margin>
        </Button>
    </children>
</StackPane>
