<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.*?>
<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="640.0" style="-fx-background-color: linear-gradient(to bottom, #1e3c72, #2a5298);" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="schoolProject.IntroductionScreenController">
    <children>
        <VBox alignment="CENTER" spacing="22.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <ImageView fitHeight="260.0"
                           fitWidth="560.0"
                           pickOnBounds="true"
                           preserveRatio="true">
                    <image>
                        <Image url="@parkifyLogo.png"/>
                    </image>
                </ImageView>
                <Label style="-fx-text-fill: #cfe0ff;" text="Find parking, effortlessly">
                    <font>
                        <Font size="17.0" />
                    </font>
                </Label>
                <Button fx:id="getStarted" mnemonicParsing="false" onAction="#switchToHomeScreen" prefHeight="58.0" prefWidth="240.0" style="-fx-background-color: #00c2a8; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-background-radius: 30; -fx-cursor: hand;" text="Get Started!" />
            </children>
        </VBox>
    </children>
</AnchorPane>
