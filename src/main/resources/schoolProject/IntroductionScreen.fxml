<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
           xmlns="http://javafx.com/javafx/8"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="schoolProject.IntroductionScreenController">
    <children>
        <VBox alignment="CENTER" spacing="18.0" styleClass="content">
            <children>
                <ImageView fitHeight="220.0" fitWidth="480.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@parkifyLogo.png"/>
                    </image>
                </ImageView>
                <Label styleClass="subtitle" text="Find parking, effortlessly"/>
                <Button fx:id="getStarted"
                        mnemonicParsing="false"
                        onAction="#switchToHomeScreen"
                        styleClass="btn, btn-primary"
                        text="Get Started"/>
            </children>
        </VBox>
    </children>
</StackPane>
