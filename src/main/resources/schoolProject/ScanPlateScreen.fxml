<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.Controllers.ScanPlateScreenController">
   <top>
      <HBox styleClass="header">
         <children>
            <Button fx:id="scanPlateBack" mnemonicParsing="false"
                    onAction="#switchToAdminScreen" styleClass="btn, btn-back" text="Back"/>
            <Label alignment="CENTER" maxWidth="Infinity" styleClass="title"
                   text="Scan License Plate" HBox.hgrow="ALWAYS"/>
            <Region styleClass="header-spacer"/>
         </children>
      </HBox>
   </top>
   <center>
      <VBox styleClass="content">
         <VBox styleClass="card">
            <children>
               <Label styleClass="eyebrow" text="PLATE SCANNING"/>
               <Label styleClass="section-title" text="Upload a license plate image."/>
               <Button fx:id="uploadFile" mnemonicParsing="false"
                       onAction="#uploadLicensePlateFile" styleClass="btn, btn-primary" text="Upload Image"/>
            </children>
         </VBox>
      </VBox>
   </center>
</BorderPane>
