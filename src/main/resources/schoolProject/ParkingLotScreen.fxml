<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.ParkingLotScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="parkingLotScreenBack"
                        mnemonicParsing="false"
                        onAction="#switchToHomeScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="Parking Lot"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content">
            <children>
                <VBox styleClass="card">
                    <children>
                        <GridPane alignment="CENTER" hgap="22.0" vgap="18.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="CENTER" minWidth="40.0"/>
                                <ColumnConstraints halignment="CENTER" minWidth="90.0"/>
                                <ColumnConstraints halignment="CENTER" minWidth="90.0"/>
                                <ColumnConstraints halignment="CENTER" minWidth="90.0"/>
                                <ColumnConstraints halignment="CENTER" minWidth="90.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints valignment="CENTER"/>
                                <RowConstraints valignment="CENTER"/>
                                <RowConstraints valignment="CENTER"/>
                            </rowConstraints>

                            <Label styleClass="axis-label" text="1" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label styleClass="axis-label" text="2" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <Label styleClass="axis-label" text="3" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                            <Label styleClass="axis-label" text="4" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                            <Label styleClass="axis-label" text="A" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Rectangle fx:id="a1" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Rectangle fx:id="a2" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <Rectangle fx:id="a3" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                            <Rectangle fx:id="a4" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                            <Label styleClass="axis-label" text="B" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Rectangle fx:id="b1" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            <Rectangle fx:id="b2" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                            <Rectangle fx:id="b3" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                            <Rectangle fx:id="b4" styleClass="spot" arcHeight="14.0" arcWidth="14.0"
                                       height="120.0" width="90.0"
                                       GridPane.columnIndex="4" GridPane.rowIndex="2"/>
                        </GridPane>
                        <Label styleClass="legend" text="Teal = available"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
