<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.Controllers.PaymentDatabaseScreenController">
   <top>
      <HBox styleClass="header">
         <children>
            <Button fx:id="paymentDatabaseBack" mnemonicParsing="false"
                    onAction="#switchToAdminScreen" styleClass="btn, btn-back" text="Back"/>
            <Label alignment="CENTER" maxWidth="Infinity" styleClass="title"
                   text="Payment Database" HBox.hgrow="ALWAYS"/>
            <Region styleClass="header-spacer"/>
         </children>
      </HBox>
   </top>
   <center>
      <VBox styleClass="content">
         <VBox styleClass="card">
            <children>
               <Label styleClass="eyebrow" text="PAYMENT REGISTRY"/>
               <Label styleClass="section-title" text="Registered payment cards."/>
               <TableView fx:id="paymentTable" prefHeight="520.0" prefWidth="730.0">
                  <columns>
                     <TableColumn fx:id="cardNumberEntry" prefWidth="245.33335399627686" text="Card Number"/>
                     <TableColumn fx:id="expirationEntry" prefWidth="113.33334350585938" text="Expiration"/>
                     <TableColumn fx:id="cvvEntry" prefWidth="84.66668701171875" text="CVV"/>
                     <TableColumn fx:id="nameEntry" prefWidth="240.0" text="Name"/>
                  </columns>
               </TableView>
            </children>
         </VBox>
      </VBox>
   </center>
</BorderPane>
