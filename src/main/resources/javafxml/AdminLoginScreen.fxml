<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.Knicks.Controllers.AdminLoginScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="adminLoginBack"
                        mnemonicParsing="false"
                        onAction="#switchToIntroductionScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="Admin Sign In"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content, login-content">
            <children>
                <VBox styleClass="card, login-card">
                    <children>
                        <Label styleClass="eyebrow" text="STAFF ACCESS"/>
                        <Label styleClass="section-title" text="Sign in to the dashboard."/>
                        <Label styleClass="subtitle" wrapText="true" maxWidth="352.0"
                               text="Admin access is separate from the customer app. Manage customers, vehicles, and transactions."/>
                        <VBox styleClass="login-field-group">
                            <children>
                                <Label styleClass="field-label" text="Username"/>
                                <TextField fx:id="usernameField" styleClass="field, login-field"
                                           promptText="admin"/>
                            </children>
                        </VBox>
                        <VBox styleClass="login-field-group">
                            <children>
                                <Label styleClass="field-label" text="Password"/>
                                <PasswordField fx:id="passwordField" styleClass="field, login-field"
                                               promptText="Password"/>
                            </children>
                        </VBox>
                        <Label fx:id="errorLabel" styleClass="login-error" managed="false" visible="false"
                               wrapText="true" maxWidth="352.0"/>
                        <Button fx:id="signInButton"
                                defaultButton="true"
                                mnemonicParsing="false"
                                onAction="#signIn"
                                styleClass="btn, btn-primary, login-button"
                                text="Sign in"/>
                        <Label fx:id="hintLabel" styleClass="login-hint" wrapText="true" maxWidth="352.0"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
