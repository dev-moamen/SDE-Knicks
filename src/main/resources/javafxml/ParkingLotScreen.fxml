<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" prefHeight="800.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="schoolProject.Knicks.Controllers.ParkingLotScreenController">
    <top>
        <HBox styleClass="header">
            <children>
                <Button fx:id="parkingLotScreenBack"
                        mnemonicParsing="false"
                        onAction="#switchToHomeScreen"
                        styleClass="btn, btn-back"
                        text="Back"/>
                <Label alignment="CENTER" maxWidth="Infinity" styleClass="title" text="Parking Lot"
                       HBox.hgrow="ALWAYS"/>
                <Region styleClass="header-spacer"/>
            </children>
        </HBox>
    </top>
    <center>
        <VBox styleClass="content, lot-content">
            <children>
                <HBox styleClass="lot-topbar">
                    <children>
                        <Label fx:id="floorTitle" styleClass="section-title" text="Parking lot"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="floorStats" styleClass="lot-stats" text=""/>
                    </children>
                </HBox>
                <Label fx:id="floorSubtitle" styleClass="subtitle" text=""/>
                <HBox fx:id="floorTabs" styleClass="floor-tabs"/>
                <HBox styleClass="lot-legend">
                    <children>
                        <Label styleClass="legend-chip, legend-free" text="Free"/>
                        <Label styleClass="legend-chip, legend-taken" text="In use"/>
                        <Label styleClass="legend-chip, legend-closed" text="Closed"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="priceNote" styleClass="legend" text=""/>
                    </children>
                </HBox>
                <VBox styleClass="card, lot-card" VBox.vgrow="ALWAYS">
                    <children>
                        <GridPane fx:id="floorMap" alignment="CENTER" hgap="10.0" vgap="10.0"/>
                        <Label styleClass="lot-hint"
                               text="Select a free spot to reserve it. Availability reflects right now."/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>
